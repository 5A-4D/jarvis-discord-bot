[Unit]
Description=Independent Jarvis nightly deployment recovery and notification outbox

[Service]
Type=oneshot
WorkingDirectory=%h/Projects/jarvis-discord-bot
ExecStart=%h/Projects/jarvis-discord-bot/.venv/bin/python %h/.local/lib/jarvis-maintenance/nightly.py supervise
TimeoutStartSec=90
UMask=0077
NoNewPrivileges=yes
