[Unit]
Description=Read-only Codex free-reset expiry warnings to the owner DM
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Projects/jarvis-discord-bot
ExecStart=%h/Projects/jarvis-discord-bot/.venv/bin/python -m jarvis_bot.reset_credit_watch --owner-id 900000000000000003
TimeoutStartSec=180
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
