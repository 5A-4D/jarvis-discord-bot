[Unit]
Description=Jarvis nightly improvement in an isolated editing container
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Projects/jarvis-discord-bot
ExecStart=%h/Projects/jarvis-discord-bot/.venv/bin/python %h/.local/lib/jarvis-maintenance/nightly.py run
ExecStopPost=%h/Projects/jarvis-discord-bot/.venv/bin/python %h/.local/lib/jarvis-maintenance/nightly.py cleanup
ExecStopPost=%h/Projects/jarvis-discord-bot/.venv/bin/python %h/.local/lib/jarvis-maintenance/nightly.py supervise
TimeoutStartSec=48min
TimeoutStopSec=90
MemoryMax=1G
UMask=0077
NoNewPrivileges=yes
