#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import sys
import time
import urllib.parse
import urllib.request
from datetime import datetime, timezone
from pathlib import Path


PROJECT_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(PROJECT_ROOT))

from jarvis_bot.send_reminder import send_message  # noqa: E402


STATUS_URL = "https://wowforeverstatus.com/status"
PUBLIC_URL = "https://wowforeverstatus.com/"


def fetch_status() -> dict[str, object]:
    query = urllib.parse.urlencode({"time": int(time.time() * 1000)})
    request = urllib.request.Request(
        f"{STATUS_URL}?{query}",
        headers={"User-Agent": "JarvisDiscordBot/1.0 (status monitor)"},
    )
    with urllib.request.urlopen(request, timeout=20) as response:
        payload = json.load(response)
    if not isinstance(payload, dict):
        raise RuntimeError("Status endpoint returned a non-object payload")
    return payload


def is_fully_online(payload: dict[str, object]) -> bool:
    return (
        payload.get("status") == "online"
        and payload.get("dataFreshness") == "fresh"
        and payload.get("sessionComplete") is True
    )


def monitor(channel_id: int, user_id: int, interval_seconds: int) -> None:
    while True:
        checked_at = datetime.now(timezone.utc).isoformat()
        try:
            payload = fetch_status()
            status = str(payload.get("status", "unknown"))
            detail = str(payload.get("statusDetail", "unknown"))
            print(
                f"{checked_at} status={status} detail={detail}",
                flush=True,
            )
            if is_fully_online(payload):
                content = (
                    f"<@{user_id}> WoW Forever is back up and reporting normal: "
                    f"the latest completed probe is fully online. {PUBLIC_URL}"
                )
                message_id = send_message(channel_id, content)
                print(
                    f"Discord notification sent and verified: message_id={message_id}",
                    flush=True,
                )
                return
        except Exception as error:
            print(f"{checked_at} monitor error: {error}", file=sys.stderr, flush=True)
        time.sleep(interval_seconds)


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Notify Discord when the WoW Forever tracker is fully online"
    )
    parser.add_argument("--channel-id", required=True, type=int)
    parser.add_argument("--user-id", required=True, type=int)
    parser.add_argument("--interval-seconds", type=int, default=300)
    args = parser.parse_args()
    if args.interval_seconds < 30:
        raise ValueError("interval must be at least 30 seconds")
    monitor(args.channel_id, args.user_id, args.interval_seconds)


if __name__ == "__main__":
    main()
