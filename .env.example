DISCORD_BOT_TOKEN=

# Optional settings
JARVIS_TRIGGER=Jarvis
MEMORY_DATABASE_PATH=./data/jarvis.sqlite3
SERVER_IDENTITIES_PATH=./data/server-identities.json
MEMORY_MAX_STORED_MESSAGES=200
CHAT_HISTORY_BACKFILL_LIMIT=1000
CHAT_CONTEXT_MESSAGES=50
CHAT_CONTEXT_MAX_CHARS=24000
CHAT_MAX_STORED_MESSAGES_PER_CHANNEL=10000
CODEX_BINARY=codex
CODEX_WORKDIR=./workspace
CODEX_SANDBOX=workspace-write
CODEX_TIMEOUT_SECONDS=900
# Optional: comma-separated authorized owner IDs with no overall request timeout.
# Public users and bot requests retain CODEX_TIMEOUT_SECONDS.
CODEX_UNLIMITED_TIMEOUT_USER_IDS=
CODEX_MODEL=
MAX_PROMPT_CHARS=12000
TELEMETRY_PATH=./data/request-telemetry.jsonl
PROGRESS_PATH=./data/live-progress.json
# Optional channel that receives a live, verbose, redacted progress dashboard.
PROGRESS_CHANNEL_ID=

# Transcribe new Discord voice notes locally; no transcription API is used.
VOICE_TRANSCRIPTION_ENABLED=false
VOICE_TRANSCRIPTION_CHANNEL_IDS=
VOICE_TRANSCRIPTION_MODEL=base.en
VOICE_TRANSCRIPTION_DEVICE=cpu
VOICE_TRANSCRIPTION_COMPUTE_TYPE=int8
VOICE_TRANSCRIPTION_MAX_BYTES=20971520
VOICE_TRANSCRIPTION_MAX_SECONDS=300

# Permanently monitor one voice channel, retain local transcripts, respond to the
# wake phrase in the paired text channel, and support recent-window summaries.
LIVE_VOICE_ENABLED=false
LIVE_VOICE_CHANNEL_ID=
LIVE_VOICE_TEXT_CHANNEL_ID=
LIVE_VOICE_WAKE_PHRASE=Hey Jarvis
LIVE_VOICE_SILENCE_SECONDS=1.2
LIVE_VOICE_SEGMENT_MAX_SECONDS=30
LIVE_VOICE_MIN_SPEECH_SECONDS=0.35
LIVE_VOICE_RMS_THRESHOLD=250
LIVE_VOICE_FOLLOWUP_SECONDS=10
LIVE_VOICE_REQUEST_COOLDOWN_SECONDS=10
LIVE_VOICE_RETENTION_DAYS=0
LIVE_VOICE_SUMMARY_MAX_MINUTES=10080
LIVE_VOICE_TIMEZONE=UTC
# Spoken requests remain informational even when spoken by an owner.
LIVE_VOICE_REQUESTS_READ_ONLY=true

# Comma-separated Discord channel IDs. Leave blank to allow every channel.
ALLOWED_CHANNEL_IDS=

# Required: comma-separated Discord user IDs permitted to command the laptop.
AUTHORIZED_USER_IDS=
# Optional: copy new incoming human DMs to this authorized owner's DM inbox.
# Excludes the recipient's own DMs, bot messages and webhooks.
DM_COPY_OWNER_ID=

# Restricted public inquiry mode. Questions, web research, technical guidance, and
# example code are allowed; shell, host writes, apps, and local-file tools remain
# disabled. 0 for CHAT_HISTORY_BACKFILL_LIMIT means all history.
PUBLIC_CHANNEL_IDS=
PUBLIC_ACCESS_ALL_CHANNELS=false
PUBLIC_SETUP_GUIDANCE_USER_IDS=
PUBLIC_MIN_FIVE_HOUR_REMAINING_PERCENT=25
PUBLIC_MAX_PROMPT_CHARS=2000
PUBLIC_MEMORY_MESSAGES=20
PUBLIC_GUILD_CONTEXT_MESSAGES=50

# Legacy compatibility settings. General incoming bot invocations are disabled
# by the current router; these flags do not grant owner/host access.
BOT_INVOCATIONS_ENABLED=false
BOT_MIN_FIVE_HOUR_REMAINING_PERCENT=50
# Legacy direct-conversation allowlist; the current router does not enable
# general bot conversations. The narrow R image adapter requires configuration.
BOT_CONVERSATION_USER_IDS=
# Legacy response-prefix customization.
R_PREFIX_USER_IDS=

# danger-full-access permits authorized users to access files outside CODEX_WORKDIR.
# Optional private Outlook availability feed. Treat its URL as a secret.
WORK_CALENDAR_ICS_URL=
WORK_CALENDAR_OWNER_ID=
# Owner opt-in: humans may view anonymous availability in DMs/public channels.
WORK_CALENDAR_PUBLIC_ENABLED=false
WORK_CALENDAR_TIMEZONE=America/Chicago
WORK_DAY_START=08:30
WORK_DAY_END=16:00
WORK_MORNING_HUDDLE_ENABLED=false
# Private SHA-256 series fingerprints whose exact weekday 12:30–13:30 lunch
# occurrences count as available. Other overlapping meetings still block time.
# Never put raw calendar event IDs or feed URLs here.
WORK_CALENDAR_FREE_SERIES_SHA256=

# Optional Compose reference deployment. Set absolute paths before using Compose.
# The selected host home is mounted for the owner-operated agent.
JARVIS_HOST_HOME=
JARVIS_WORKSPACE_HOST=
JARVIS_CODEX_BINARY=
HOST_UID=1000
HOST_GID=1000
